#version 450 core

layout(points) in;
layout(triangle_strip, max_vertices = 4) out;

out vec2 f_texCoord;

void main(){
    gl_Position = gl_in[0].gl_Position + vec4(-0.25,-0.25, 0, 0);
    f_texCoord = vec2(0,0);
    EmitVertex();

    gl_Position = gl_in[0].gl_Position + vec4(-0.25, 0.25, 0, 0);
    f_texCoord = vec2(0,0);
    EmitVertex();

    gl_Position = gl_in[0].gl_Position + vec4( 0.25,-0.25, 0, 0);
    f_texCoord = vec2(0,0);
    EmitVertex();
    
    gl_Position = gl_in[0].gl_Position + vec4( 0.25, 0.25, 0, 0);
    f_texCoord = vec2(0,0);
    EmitVertex();

    

    EndPrimitive();
}